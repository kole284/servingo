// See docs/BACKEND_PLAN.md (kept locally). Money is whole dinars; quantities are tenths of a unit.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Service {
  ketering
  torte_i_kolaci @map("torte-i-kolaci")
  kuvana_jela    @map("kuvana-jela")
  pica

  @@map("service")
}

enum Unit {
  kg
  kom
  porcija
  paket

  @@map("unit")
}

/// The id is the URL slug, e.g. "bistro-dorcol".
model Restaurant {
  id            String              @id
  name          String
  /// Part of town, shown on the site.
  area          String
  /// Pickup address; sent to the customer only after payment, never to the frontend.
  pickupAddress String              @map("pickup_address")
  city          String
  /// Where this restaurant's orders go.
  orderEmail    String              @map("order_email")
  phone         String
  /// Minimum hours between ordering and the delivery slot.
  leadTimeHours Int                 @map("lead_time_hours")
  isActive      Boolean             @default(true) @map("is_active")
  imageUrl      String?             @map("image_url")
  /// Kept in step with reviews; null until the first one.
  ratingAvg     Float?              @map("rating_avg")
  ratingCount   Int                 @default(0) @map("rating_count")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  services      RestaurantService[]
  menuItems     MenuItem[]
  bills         Bill[]

  @@map("restaurants")
}

/// What a restaurant offers. Drinks are not listed: every restaurant sells Servingo's.
model RestaurantService {
  restaurantId String     @map("restaurant_id")
  service      Service
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, service])
  @@map("restaurant_services")
}

/// A dish, or a Servingo drink when restaurantId is null (the migration enforces this with service = 'pica').
model MenuItem {
  id           String      @id @default(cuid())
  restaurantId String?     @map("restaurant_id")
  service      Service
  name         String
  description  String
  priceRsd     Int         @map("price_rsd")
  unit         Unit
  /// Shown next to the price, e.g. "paket od 8 × 0,33 l".
  unitNote     String?     @map("unit_note")
  /// Quantities are tenths of a unit: 5 = 0,5 kg.
  minQtyTenths Int         @default(10) @map("min_qty_tenths")
  stepTenths   Int         @default(10) @map("step_tenths")
  isPopular    Boolean     @default(false) @map("is_popular")
  isActive     Boolean     @default(true) @map("is_active")
  sortOrder    Int         @default(0) @map("sort_order")
  imageUrl     String?     @map("image_url")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  billItems    BillItem[]

  @@index([restaurantId, sortOrder])
  @@map("menu_items")
}

/// Places with delivery; anywhere else is pickup only.
model DeliveryCity {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  isActive  Boolean @default(true) @map("is_active")
  sortOrder Int     @default(0) @map("sort_order")

  @@map("delivery_cities")
}

/// A single row (id = 1). Bills copy these amounts, so changes never touch past orders.
model Settings {
  id                    Int      @id @default(1)
  deliveryFeeRsd        Int      @map("delivery_fee_rsd")
  platformFeeRsd        Int      @map("platform_fee_rsd")
  deliveryMinimumRsd    Int      @map("delivery_minimum_rsd")
  /// Gets a copy of every bill with drinks, since Servingo supplies them.
  servingoOrdersEmail   String   @default("porudzbine@servingo.rs") @map("servingo_orders_email")
  /// Receives the Kontakt and "Postani deo nas" forms.
  contactEmail          String   @default("podrska@servingo.rs") @map("contact_email")
  /// How long an order waits for payment before it counts as cancelled.
  pendingPaymentMinutes Int      @default(30) @map("pending_payment_minutes")
  /// What a partner's promo code takes off the items, in percent; delivery and the platform fee are then free.
  promoDiscountPercent  Int      @default(3) @map("promo_discount_percent")
  /// What a company on monthly invoice pays instead of the flat platform fee, in percent of the items.
  companyFeePercent     Int      @default(5) @map("company_fee_percent")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

enum Method {
  dostava
  preuzimanje

  @@map("method")
}

enum BuyerType {
  fizicko
  pravno

  @@map("buyer_type")
}

enum OrderStatus {
  pending_payment
  paid
  /// A company's order: confirmed at once and charged on the company's monthly invoice.
  on_invoice
  payment_failed
  cancelled
  refunded

  @@map("order_status")
}

enum PaymentMethod {
  card
  invoice

  @@map("payment_method")
}

enum Fulfilment {
  delivery
  pickup

  @@map("fulfilment")
}

enum PickupReason {
  chosen
  city
  minimum

  @@map("pickup_reason")
}

enum BillStatus {
  new
  confirmed
  ready
  delivered
  picked_up
  cancelled

  @@map("bill_status")
}

enum PaymentStatus {
  succeeded
  failed

  @@map("payment_status")
}

enum Recipient {
  customer
  restaurant
  servingo

  @@map("recipient")
}

enum NotificationStatus {
  sent
  failed
  /// No mail provider configured; the email was only written to the log.
  logged

  @@map("notification_status")
}

/// One card payment by the customer, covering one bill per restaurant.
model Order {
  id               String           @id @default(cuid())
  /// Shown to the customer, e.g. "SRV-7K3Q9".
  publicCode       String           @unique @map("public_code")
  /// Lets the customer see the order status without an account.
  accessToken      String           @map("access_token")
  /// Language of the customer's emails.
  locale           String
  deliveryDate     DateTime         @map("delivery_date") @db.Date
  slotHour         Int              @map("slot_hour")
  method           Method
  /// Set only when at least one bill is delivered.
  city             String?
  address          String?
  customerName     String           @map("customer_name")
  email            String
  phone            String
  buyerType        BuyerType        @map("buyer_type")
  companyName      String?          @map("company_name")
  pib              String?
  mb               String?
  totalRsd         Int              @map("total_rsd")
  status           OrderStatus      @default(pending_payment)
  idempotencyKey   String           @unique @map("idempotency_key")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  /// After this a pending order counts as cancelled, even before the cleanup job runs.
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(6)
  paidAt           DateTime?        @map("paid_at") @db.Timestamptz(6)
  /// The partner code used, if any; the code text and percent are copied so the order reads the same later.
  promoCodeId      String?          @map("promo_code_id")
  promoCode        String?          @map("promo_code")
  discountPercent  Int              @default(0) @map("discount_percent")
  /// The order at the normal price, shown struck through next to totalRsd when a promo code lowered it.
  originalTotalRsd Int?             @map("original_total_rsd")
  bills            Bill[]
  payments         Payment[]
  notifications    Notification[]
  promo            PromoCode?       @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  redemption       PromoRedemption?
  paymentMethod    PaymentMethod    @default(card) @map("payment_method")
  /// The company whose monthly invoice this order goes on; email above is the employee who ordered.
  companyId        String?          @map("company_id")
  companyInvoiceId String?          @map("company_invoice_id")
  company          Company?         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  companyInvoice   CompanyInvoice?  @relation(fields: [companyInvoiceId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([companyId, createdAt])
  @@map("orders")
}

/// One restaurant's bill within an order; restaurantId is null for Servingo's own drinks bill.
model Bill {
  id                 String         @id @default(cuid())
  orderId            String         @map("order_id")
  restaurantId       String?        @map("restaurant_id")
  /// Copied so the bill reads the same if the restaurant is renamed.
  sellerName         String         @map("seller_name")
  fulfilment         Fulfilment
  pickupReason       PickupReason?  @map("pickup_reason")
  subtotalRsd        Int            @map("subtotal_rsd")
  deliveryFeeRsd     Int            @map("delivery_fee_rsd")
  platformFeeRsd     Int            @map("platform_fee_rsd")
  totalRsd           Int            @map("total_rsd")
  /// Dinars a promo code took off the items; deliveryFeeRsd and platformFeeRsd are then 0.
  discountRsd        Int            @default(0) @map("discount_rsd")
  /// The fees and total at the normal price, for showing them struck through.
  baseDeliveryFeeRsd Int            @default(0) @map("base_delivery_fee_rsd")
  basePlatformFeeRsd Int            @default(0) @map("base_platform_fee_rsd")
  originalTotalRsd   Int?           @map("original_total_rsd")
  hasDrinks          Boolean        @map("has_drinks")
  status             BillStatus     @default(new)
  /// Filled once invoicing is decided (open question 2 in the plan).
  invoiceNumber      String?        @map("invoice_number")
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restaurant         Restaurant?    @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items              BillItem[]
  notifications      Notification[]

  @@index([orderId])
  @@index([restaurantId, status])
  @@map("bills")
}

/// A line as it was bought: name and price are copied from the menu.
model BillItem {
  id             String    @id @default(cuid())
  billId         String    @map("bill_id")
  menuItemId     String?   @map("menu_item_id")
  name           String
  unit           Unit
  unitNote       String?   @map("unit_note")
  unitPriceRsd   Int       @map("unit_price_rsd")
  quantityTenths Int       @map("quantity_tenths")
  lineTotalRsd   Int       @map("line_total_rsd")
  isDrink        Boolean   @map("is_drink")
  sortOrder      Int       @default(0) @map("sort_order")
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  menuItem       MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@map("bill_items")
}

/// Every payment result the provider reported; the unique key makes a repeated callback a no-op.
model Payment {
  id          String        @id @default(cuid())
  orderId     String        @map("order_id")
  provider    String
  providerRef String        @map("provider_ref")
  amountRsd   Int           @map("amount_rsd")
  status      PaymentStatus
  rawPayload  Json?         @map("raw_payload")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@map("payments")
}

/// A partner (someone who recommends Servingo) and their code. Customers using it get a discount;
/// the partner earns commissionTenths of the items after the discount, paid out monthly.
model PromoCode {
  id               String            @id @default(cuid())
  /// Stored in capitals; customers may type it in any case.
  code             String            @unique
  ownerName        String            @map("owner_name")
  ownerEmail       String?           @map("owner_email")
  ownerPhone       String?           @map("owner_phone")
  /// The partner's share in tenths of a percent (50 = 5,0 %).
  commissionTenths Int               @map("commission_tenths")
  isActive         Boolean           @default(true) @map("is_active")
  /// The code stops working after this moment; null for no end.
  expiresAt        DateTime?         @map("expires_at") @db.Timestamptz(6)
  note             String?
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  orders           Order[]
  redemptions      PromoRedemption[]
  payouts          PromoPayout[]

  @@map("promo_codes")
}

/// One paid order made with a partner's code: what the partner earned on it. Written when the order is paid.
model PromoRedemption {
  id               String       @id @default(cuid())
  promoCodeId      String       @map("promo_code_id")
  orderId          String       @unique @map("order_id")
  usedAt           DateTime     @default(now()) @map("used_at") @db.Timestamptz(6)
  /// The items after the discount, which the commission is worked out from.
  baseRsd          Int          @map("base_rsd")
  /// Copied from the code when it was used, so changing the code later never changes past earnings.
  commissionTenths Int          @map("commission_tenths")
  commissionRsd    Int          @map("commission_rsd")
  /// Set once the partner has been paid for the month.
  payoutId         String?      @map("payout_id")
  promo            PromoCode    @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  order            Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payout           PromoPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([promoCodeId, usedAt])
  @@map("promo_redemptions")
}

/// A month's commission paid to a partner.
model PromoPayout {
  id          String            @id @default(cuid())
  promoCodeId String            @map("promo_code_id")
  /// "2026-11", by the Belgrade date the orders were paid.
  month       String
  amountRsd   Int               @map("amount_rsd")
  paidAt      DateTime          @default(now()) @map("paid_at") @db.Timestamptz(6)
  promo       PromoCode         @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  redemptions PromoRedemption[]

  @@unique([promoCodeId, month])
  @@map("promo_payouts")
}

/// A company that orders on monthly invoice. Its employees order with the company's code and their own email,
/// which must be on the member list or on the company's email domain.
model Company {
  id           String           @id @default(cuid())
  name         String
  pib          String           @unique
  mb           String
  address      String
  /// Gets a copy of every order and the monthly invoice.
  billingEmail String           @map("billing_email")
  /// Given to employees, e.g. "FIRMA-7K3Q".
  orderCode    String           @unique @map("order_code")
  /// Anyone with an email on this domain (e.g. "firma.rs") may order; null for the member list only.
  emailDomain  String?          @map("email_domain")
  /// Overrides Settings.companyFeePercent for this company; null for the default.
  feePercent   Int?             @map("fee_percent")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  members      CompanyMember[]
  orders       Order[]
  invoices     CompanyInvoice[]

  @@map("companies")
}

model CompanyMember {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  /// Stored in lower case.
  email     String
  name      String?
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@map("company_members")
}

/// A month's invoice to a company: the sum of its orders, issued by the admin.
model CompanyInvoice {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  /// "2026-11", by the Belgrade date the orders were placed.
  month       String
  /// e.g. "SRV-F-2026-11-001".
  number      String    @unique
  subtotalRsd Int       @map("subtotal_rsd")
  deliveryRsd Int       @map("delivery_rsd")
  feeRsd      Int       @map("fee_rsd")
  totalRsd    Int       @map("total_rsd")
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz(6)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(6)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  orders      Order[]

  @@unique([companyId, month])
  @@map("company_invoices")
}

/// Log of every email sent (or attempted) about an order.
model Notification {
  id        String             @id @default(cuid())
  orderId   String             @map("order_id")
  billId    String?            @map("bill_id")
  recipient Recipient
  toEmail   String             @map("to_email")
  template  String
  status    NotificationStatus
  error     String?
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bill      Bill?              @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("notifications")
}

enum ApplicationStatus {
  new
  contacted
  accepted
  rejected

  @@map("application_status")
}

/// The Kontakt form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  /// Optional order code, e.g. "SRV-7K3Q9", when the question is about an order.
  orderCode String?  @map("order_code")
  message   String
  locale    String
  /// HMAC of the sender's IP, only for limiting repeated sends.
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipHash, createdAt])
  @@map("contact_messages")
}

/// The "Postani deo nas" form.
model PartnerApplication {
  id           String            @id @default(cuid())
  businessName String            @map("business_name")
  /// What they would offer, as the site's categories (ketering, torte i kolači, kuvana jela, pića).
  services     Service[]
  contactName  String            @map("contact_name")
  email        String
  phone        String
  /// Town or part of town.
  area         String
  message      String?
  status       ApplicationStatus @default(new)
  locale       String
  ipHash       String            @map("ip_hash")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ipHash, createdAt])
  @@index([status])
  @@map("partner_applications")
}

// Better Auth (admin sign-in). Field names follow Better Auth's core schema.

/// Servingo staff who can open /admin. There is no public sign-up; see prisma/create-admin.ts.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// "admin" for Servingo staff; restaurant logins may come later.
  role          String    @default("admin")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Sign-in methods; an email and password login is providerId "credential" with the password hash.
model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([identifier])
  @@map("verifications")
}
